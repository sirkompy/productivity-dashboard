{
  "name": "productivity-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "migrate": "npm run cli -- migrate",
    "watchlist:add": "npm run cli -- watchlist:add",
    "ingest": "npm run cli -- ingest",
    "outliers": "npm run cli -- outliers"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@electric-sql/pglite": "^0.3.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
